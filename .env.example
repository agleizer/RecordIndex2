# RecordIndex 2.0 — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434

# Modelos a baixar no startup (comma-separated).
# Inclua todos os modelos com provider=ollama referenciados abaixo.
OLLAMA_MODELS_PULL=qwen3.5:9b

# --- Provider e modelo por agente ---
# Provider: ollama | ollama_cloud | anthropic | openai
# ollama_cloud: modelos hospedados no Ollama Cloud (kimi-k3, qwen3.5:122b, ...) — requer OLLAMA_API_KEY abaixo
#
# A0: orquestrador — raciocínio sobre configuração e feedback loop
A0_PROVIDER=ollama
A0_MODEL=qwen3.5:9b
# A2: HTR multimodal — obrigatoriamente um VLM (suporte a imagem)
# Modelos locais testados: qwen3.5:9b (alucina), gemma4:e4b (parcial), qwen3-vl:8b (não testado)
# Recomendado: gemma4:e4b como primário + fallback Claude Sonnet para registros difíceis
A2_PROVIDER=anthropic
A2_MODEL=qwen3.5:9b
# A2 fallback: acionado pelo A0 quando A6 detecta score < A2_FALLBACK_THRESHOLD
# Deixar A2_FALLBACK_MODEL vazio para desabilitar o fallback
A2_FALLBACK_PROVIDER=
A2_FALLBACK_MODEL=
A2_FALLBACK_THRESHOLD=0.5
# A3: segmentação de registros
A3_PROVIDER=ollama
A3_MODEL=qwen3.5:9b
# A4: correção estrutural
A4_PROVIDER=ollama
A4_MODEL=qwen3.5:9b
# A5: NER / extração estruturada
A5_PROVIDER=ollama
A5_MODEL=qwen3.5:9b
# A6: validação
A6_PROVIDER=ollama
A6_MODEL=qwen3.5:9b

# --- AG/AM: modo de pipeline generalista (alternativo ao MAS A0-A6) ---
# Ver 2026_08_16_modulo_generalista_vs_mas/. Ativado por pipeline_mode="generalist"
# no /pipeline/run (o padrão continua "mas", este bloco não afeta o pipeline principal).
# AG: agente generalista (HTR + segmentação + extração numa chamada por página)
# AM: agente de merge (só roda quando AG sinaliza continuação entre páginas)
# Se deixados vazios, caem no valor de A2_PROVIDER/A2_MODEL (AG) e AG_PROVIDER/AG_MODEL (AM).
AG_PROVIDER=
AG_MODEL=
AM_PROVIDER=
AM_MODEL=

# --- API keys para providers externos ---
# Necessárias apenas se algum provider acima for "anthropic" ou "openai".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Necessária apenas se algum provider acima for "ollama_cloud".
OLLAMA_API_KEY=

# --- Diretórios (caminhos dentro dos containers) ---
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
SAMPLES_DIR=/data/samples

# --- Banco de jobs (Postgres) ---
# Persiste o estado da fila de jobs (etapa 1) e, adiante, os registros extraídos
# (etapa 2). O serviço `jobsdb` no compose usa USER/PASSWORD/NAME; o serviço
# `jobs` monta JOBS_DB_DSN a partir deles.
# JOBS_DB_HOST_PORT: porta publicada no host para conectar por fora (DBeaver/pgAdmin).
#   Padrão 5433 para não colidir com um Postgres instalado localmente na 5432.
JOBS_DB_USER=recordindex
JOBS_DB_PASSWORD=troque-esta-senha
JOBS_DB_NAME=jobs
JOBS_DB_HOST_PORT=5433

# --- Login do front (Streamlit) ---
# Credencial única de acesso à interface. É um gate só no front: os serviços
# jobs/app/eval continuam acessíveis por suas portas (decisão de desenvolvimento),
# então o login não protege a API, só a UI. Deixe FRONT_PASSWORD vazio p/ desligar.
FRONT_USER=admin
FRONT_PASSWORD=troque-esta-senha

# --- Filtros de qualidade A1 ---
# A1_MIN_WIDTH: piso absoluto de largura em px. Fragmentos menores são descartados
#   antes de qualquer cálculo estatístico.
# A1_OUTLIER_SENSITIVITY (k): fator IQR para detecção de outliers por página.
#   Linha é inválida se altura < Q1 - k*IQR  ou  aspect_ratio < Q1 - k*IQR.
#   k=1.5 padrão estatístico; k=1.0 mais agressivo; k=2.5 mais permissivo.
# A1_OUTLIER_MIN_LINES: mínimo de linhas na página para calcular IQR.
#   Abaixo desse limite, apenas A1_MIN_WIDTH se aplica.
A1_MIN_WIDTH=200
A1_OUTLIER_SENSITIVITY=1.5
A1_OUTLIER_MIN_LINES=6

# --- Filtros de qualidade A3 ---
# A3_MIN_HTR_CHARS: linhas com transcrição A2 mais curta que N chars são descartadas antes
#   do A3. Evita que ruídos ("A", "†", "") confundam a detecção de limites de registro.
#   Padrão: 8. Aumentar se o corpus tiver muitas linhas fragmentadas.
# A3_OUTLIER_MULTIPLIER: registros com mais que avg_linhas * k são re-segmentados pelo A3.
#   Detecta merges — casos em que o A3 juntou dois registros em um.
#   k=0 desabilita. Padrão 2.0 (só merges graves). Diminuir para 1.5 em coleções densas.
A3_MIN_HTR_CHARS=8
A3_OUTLIER_MULTIPLIER=2.0

# --- A6 — Validação ---
# A6_LLM_THRESHOLD: aciona a camada LLM do A6 apenas quando score < threshold.
#   Aumentar para acionar o LLM com mais frequência (mais análise, mais custo).
#   Diminuir para economizar (só regras determinísticas na maioria dos registros).
# A6_NUM_PREDICT: limite de tokens gerados pelo LLM do A6.
#   200 é suficiente para análise concisa. Aumentar se as notas ficarem truncadas.
A6_LLM_THRESHOLD=0.8
A6_NUM_PREDICT=200

# --- A0 — Classificação e segmentação ---
# A0_CLASSIFY_SAMPLE_PAGES: páginas amostradas para classificar a coleção via LLM (fallback).
#   Aumentar para coleções heterogêneas (capas, índices, páginas em branco intercaladas).
# A0_AVG_LINES_WINDOW: janela de histórico para calcular avg_lines_hint (últimos N registros).
#   Janela menor reage mais rápido a variações de layout; maior é mais estável.
# A0_AVG_LINES_MIN_HISTORY: mínimo de registros fechados para ativar o avg_lines_hint.
#   Abaixo desse número o hint não é enviado ao A3 (evita hint instável no início).
A0_CLASSIFY_SAMPLE_PAGES=3
A0_AVG_LINES_WINDOW=20
A0_AVG_LINES_MIN_HISTORY=3

# --- Avaliação (evaluation service) ---
# EVAL_MATCH_THRESHOLD: score mínimo para aceitar um alinhamento GT↔output.
#   Diminuir para aceitar matches mais incertos; aumentar para exigir correspondência forte.
# EVAL_NOME_MIN: JW mínimo do campo primário (nome/noivo) para o par ser candidato.
#   Pré-filtro que evita que pai+mae resgatem um nome completamente errado.
# EVAL_SECONDARY_RESCUE_MIN: se nome falha EVAL_NOME_MIN mas a média dos campos
#   secundários (pai+mae) atinge esse threshold, o match é considerado.
#   Cobre o caso de A5 com entidade errada no nome mas pai+mae corretos.
# EVAL_FUZZY_THRESHOLD: JW mínimo para considerar dois valores de campo como equivalentes.
EVAL_MATCH_THRESHOLD=0.80
EVAL_NOME_MIN=0.65
EVAL_SECONDARY_RESCUE_MIN=0.85
EVAL_FUZZY_THRESHOLD=0.85

# --- Debug ---
# true: inclui debug_raw nas respostas da API e loga o objeto completo do LangChain
DEBUG=false
