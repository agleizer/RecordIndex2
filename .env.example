# RecordIndex 2.0: copie para .env e ajuste.

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
# Modelos baixados no startup (separados por vírgula); inclua todos os de provider ollama
OLLAMA_MODELS_PULL=qwen3.5:9b

# --- Provider e modelo por agente ---
# Providers: ollama | ollama_cloud | anthropic | openai
# Nos experimentos do relatório, o mesmo modelo foi usado em todos os agentes:
# qwen3.5:9b (ollama), qwen3.5:397b-cloud (ollama_cloud) ou claude-sonnet-4-6 (anthropic)
A0_PROVIDER=ollama
A0_MODEL=qwen3.5:9b
# A2 precisa ser um modelo multimodal (recebe imagem)
A2_PROVIDER=ollama
A2_MODEL=qwen3.5:9b
# Fallback do A2 quando o score do A6 fica abaixo do limiar; modelo vazio desliga
A2_FALLBACK_PROVIDER=
A2_FALLBACK_MODEL=
A2_FALLBACK_THRESHOLD=0.5
A3_PROVIDER=ollama
A3_MODEL=qwen3.5:9b
A4_PROVIDER=ollama
A4_MODEL=qwen3.5:9b
A5_PROVIDER=ollama
A5_MODEL=qwen3.5:9b
A6_PROVIDER=ollama
A6_MODEL=qwen3.5:9b

# --- Modo generalista (AG e AM) ---
# Vazios: AG usa o modelo do A2, e AM usa o do AG
AG_PROVIDER=
AG_MODEL=
AM_PROVIDER=
AM_MODEL=

# --- Chaves de API (só para os providers usados) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=

# --- Diretórios dentro dos containers ---
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
SAMPLES_DIR=/data/samples

# --- Banco (Postgres) ---
JOBS_DB_USER=recordindex
JOBS_DB_PASSWORD=troque-esta-senha
JOBS_DB_NAME=jobs
# Porta no host; 5433 evita conflito com um Postgres local na 5432
JOBS_DB_HOST_PORT=5433

# --- Login da interface (protege só a interface, não a API); senha vazia desliga ---
FRONT_USER=admin
FRONT_PASSWORD=troque-esta-senha

# --- A1: segmentação de linhas ---
# largura mínima (px); recortes menores são descartados
A1_MIN_WIDTH=200
# altura mínima (px); recortes menores recebem borda branca
A1_MIN_HEIGHT=40
# fator k do IQR para descartar linhas atípicas
A1_OUTLIER_SENSITIVITY=1.5
# mínimo de linhas na página para aplicar o IQR
A1_OUTLIER_MIN_LINES=6

# --- A3: delimitação de registros ---
# linhas transcritas mais curtas são ignoradas
A3_MIN_HTR_CHARS=8
# acima disso, a página é descartada (leitura corrompida)
A3_MAX_BLOCKS_PER_PAGE=5
# registros com mais de k vezes a média de linhas são re-segmentados; 0 desliga
A3_OUTLIER_MULTIPLIER=2.0

# --- A6: validação ---
# o LLM só é chamado quando o score fica abaixo disso
A6_LLM_THRESHOLD=0.8
# limite de tokens da resposta do LLM
A6_NUM_PREDICT=200

# --- A0: orquestração ---
# páginas usadas para classificar a coleção
A0_CLASSIFY_SAMPLE_PAGES=3
# registros usados na média de linhas por registro
A0_AVG_LINES_WINDOW=20
# registros fechados antes de usar essa média
A0_AVG_LINES_MIN_HISTORY=3

# --- Avaliação ---
# score mínimo para casar saída e ground truth
EVAL_MATCH_THRESHOLD=0.80
# Jaro-Winkler mínimo do nome para o par ser candidato
EVAL_NOME_MIN=0.65
# média de pai+mãe que resgata um nome abaixo do mínimo
EVAL_SECONDARY_RESCUE_MIN=0.85
# Jaro-Winkler mínimo para dois valores serem equivalentes
EVAL_FUZZY_THRESHOLD=0.85

# --- Debug ---
DEBUG=false
