# RecordIndex 2.0 — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434

# Modelos a baixar no startup (comma-separated).
# Inclua todos os modelos com provider=ollama referenciados abaixo.
OLLAMA_MODELS_PULL=gemma4:e4b,llama3.2

# --- Provider e modelo por agente ---
# Provider: ollama | anthropic | openai
#
# A0: orquestrador — raciocínio sobre configuração e feedback loop
A0_PROVIDER=ollama
A0_MODEL=llama3.2
# A2: HTR multimodal — obrigatoriamente um VLM (suporte a imagem)
# Modelos locais testados: qwen3.5:9b (alucina), gemma4:e4b (parcial), qwen3-vl:8b (não testado)
# Recomendado: gemma4:e4b como primário + fallback Claude Sonnet para registros difíceis
A2_PROVIDER=ollama
A2_MODEL=gemma4:e4b
# A2 fallback: acionado pelo A0 quando A6 detecta score < A2_FALLBACK_THRESHOLD
# Deixar A2_FALLBACK_MODEL vazio para desabilitar o fallback
A2_FALLBACK_PROVIDER=anthropic
A2_FALLBACK_MODEL=claude-sonnet-4-6
A2_FALLBACK_THRESHOLD=0.5
# A3: segmentação de registros
A3_PROVIDER=ollama
A3_MODEL=llama3.2
# A4: correção estrutural
A4_PROVIDER=ollama
A4_MODEL=llama3.2
# A5: NER / extração estruturada
A5_PROVIDER=ollama
A5_MODEL=llama3.2
# A6: validação
A6_PROVIDER=ollama
A6_MODEL=llama3.2

# --- API keys para providers externos ---
# Necessárias apenas se algum provider acima for "anthropic" ou "openai".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Diretórios (caminhos dentro dos containers) ---
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
SAMPLES_DIR=/data/samples

# --- Filtros de qualidade A1 ---
# A1_MIN_WIDTH: piso absoluto de largura em px. Fragmentos menores são descartados
#   antes de qualquer cálculo estatístico.
# A1_OUTLIER_SENSITIVITY (k): fator IQR para detecção de outliers por página.
#   Linha é inválida se altura < Q1 - k*IQR  ou  aspect_ratio < Q1 - k*IQR.
#   k=1.5 padrão estatístico; k=1.0 mais agressivo; k=2.5 mais permissivo.
# A1_OUTLIER_MIN_LINES: mínimo de linhas na página para calcular IQR.
#   Abaixo desse limite, apenas A1_MIN_WIDTH se aplica.
A1_MIN_WIDTH=200
A1_OUTLIER_SENSITIVITY=1.5
A1_OUTLIER_MIN_LINES=6

# --- Filtros de qualidade A3 ---
# A3_MIN_HTR_CHARS: linhas com transcrição A2 mais curta que N chars são descartadas antes
#   do A3. Evita que ruídos ("A", "†", "") confundam a detecção de limites de registro.
#   Padrão: 8. Aumentar se o corpus tiver muitas linhas fragmentadas.
# A3_OUTLIER_MULTIPLIER: registros com mais que avg_linhas * k são re-segmentados pelo A3.
#   Detecta merges — casos em que o A3 juntou dois registros em um.
#   k=0 desabilita. Padrão 2.0 (só merges graves). Diminuir para 1.5 em coleções densas.
A3_MIN_HTR_CHARS=8
A3_OUTLIER_MULTIPLIER=2.0

# --- Debug ---
# true: inclui debug_raw nas respostas da API e loga o objeto completo do LangChain
DEBUG=false
